# LLM provider: anthropic | openai (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Gemini OpenAI endpoint)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# Only for openai-compatible providers
LLM_BASE_URL=https://api.openai.com/v1
# live = call the API (falls back to cache on error), cached = replay stored responses only, off = no LLM at all
LLM_MODE=cached
DATABASE_URL=sqlite:///data/intellilabel.db
SEED=42
# Leave empty to let the Streamlit app call the API in-process (no separate server needed)
API_URL=
